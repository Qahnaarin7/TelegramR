diff --git a/Telegram/SourceFiles/api/api_mod_delay.h b/Telegram/SourceFiles/api/api_mod_delay.h
new file mode 100644
index 0000000..5526fbb
--- /dev/null
+++ b/Telegram/SourceFiles/api/api_mod_delay.h
@@ -0,0 +1,55 @@
+#pragma once
+
+#include "api/api_common.h"
+#include "base/unixtime.h"
+#include "core/mod_settings.h"
+#include "data/data_peer.h"
+
+namespace Api {
+
+inline bool ModDelayEnabled() {
+	return qEnvironmentVariableIntValue("TDESKTOP_MOD_ISOLATED")
+		&& qEnvironmentVariableIntValue("TDESKTOP_MOD_DELAY")
+		&& qEnvironmentVariableIntValue("TDESKTOP_MOD_OFFLINE")
+		&& qEnvironmentVariableIntValue("TDESKTOP_MOD_UNREAD")
+		&& qEnvironmentVariableIntValue("TDESKTOP_MOD_TYPING");
+}
+
+inline TimeId ModScheduledDate(const SendOptions &options) {
+	return options.modDelayed
+		? base::unixtime::now() + 12
+		: options.scheduled;
+}
+
+inline void ApplyModDelay(
+		SendOptions &options,
+		not_null<PeerData*> peer,
+		bool refresh = false) {
+	if (qEnvironmentVariableIntValue("TDESKTOP_MOD_ISOLATED")
+		&& Core::ModChatOption("silent", peer->id.value, Core::kModSilent)) {
+		options.silent = true;
+	}
+	if (options.modDelayed) {
+		if (refresh) {
+			options.scheduled = base::unixtime::now() + 12;
+		}
+		return;
+	}
+	if (options.scheduled
+		|| options.shortcutId
+		|| options.welcomeTemplate
+		|| options.ttlSeconds
+		|| options.price
+		|| options.suggest
+		|| peer->isBot()
+		|| peer->starsPerMessage()
+		|| !ModDelayEnabled()
+		|| !Core::ModChatOption("delay", peer->id.value, Core::kModDelay)
+		|| !Core::ModUnreadBlocked(peer->id.value)) {
+		return;
+	}
+	options.scheduled = base::unixtime::now() + 12;
+	options.modDelayed = true;
+}
+
+} // namespace Api
