@@ -0,0 +1,171 @@
+#pragma once
+
+#include "core/application.h"
+#include "core/mod_crypto.h"
+#include <memory>
+#include <openssl/evp.h>
+#include <QtCore/QCoreApplication>
+#include <QtCore/QCryptographicHash>
+#include <QtCore/QDir>
+#include <QtCore/QFileInfo>
+#include <QtCore/QJsonDocument>
+#include <QtCore/QJsonObject>
+#include <QtCore/QProcess>
+#include <QtCore/QSaveFile>
+#include <QtCore/QStandardPaths>
+#include <QtNetwork/QNetworkAccessManager>
+#include <QtNetwork/QNetworkReply>
+#include <QtNetwork/QNetworkRequest>
+
+namespace Core {
+
+inline constexpr auto ModVersionCode = 500;
+inline const auto ModVersion = QStringLiteral("0.5.0");
+
+class ModUpdater final : public QObject {
+public:
+	ModUpdater(QObject *parent, Fn<void(QString)> status)
+	: QObject(parent), _network(this), _status(std::move(status)) {
+	}
+
+	void activate() {
+		if (_busy) return;
+		if (!_ready.isEmpty()) {
+			launch(false);
+		} else if (_url.isValid()) {
+			download();
+		} else {
+			check();
+		}
+	}
+
+	void rollback() {
+		if (!_busy) launch(true);
+	}
+
+private:
+	QNetworkReply *get(const QUrl &url) {
+		auto request = QNetworkRequest(url);
+		request.setRawHeader("User-Agent", "TelegramR/0.5.0");
+		request.setAttribute(QNetworkRequest::RedirectPolicyAttribute, QNetworkRequest::NoLessSafeRedirectPolicy);
+		request.setTransferTimeout(30000);
+		return _network.get(request);
+	}
+
+	void check() {
+		_busy = true;
+		_status(u"Перевіряю підписаний реліз…"_q);
+		const auto reply = get(QUrl(u"https://github.com/Qahnaarin7/TelegramR/releases/latest/download/telegramr-update.json"_q));
+		const auto bytes = std::make_shared<QByteArray>();
+		QObject::connect(reply, &QNetworkReply::readyRead, this, [=] {
+			bytes->append(reply->readAll());
+			if (bytes->size() > 65536) reply->abort();
+		});
+		QObject::connect(reply, &QNetworkReply::finished, this, [=] {
+			_busy = false;
+			reply->deleteLater();
+			bytes->append(reply->readAll());
+			if (reply->error() != QNetworkReply::NoError || bytes->size() > 65536) {
+				_status(u"Канал релізів недоступний. Можна спробувати ще раз."_q);
+				return;
+			}
+			const auto envelope = QJsonDocument::fromJson(*bytes).object();
+			const auto payload = QByteArray::fromBase64(envelope[u"payload"_q].toString().toLatin1());
+			const auto signature = QByteArray::fromBase64(envelope[u"signature"_q].toString().toLatin1());
+			const auto publicKey = QByteArray::fromHex("80c768148dd77cfc35e6b7349a1c34fcb3d954d0423d681d827e367bc5a40ba5");
+			if (!ModCrypto::VerifyRelease(ModCrypto::Bytes(payload.begin(), payload.end()),
+				ModCrypto::Bytes(signature.begin(), signature.end()), ModCrypto::Bytes(publicKey.begin(), publicKey.end()))) {
+				_status(u"Підпис релізу недійсний. Оновлення відхилено."_q);
+				return;
+			}
+			const auto data = QJsonDocument::fromJson(payload).object();
+			const auto url = QUrl(data[u"url"_q].toString());
+			const auto hashText = data[u"sha256"_q].toString().toLatin1();
+			const auto hash = QByteArray::fromHex(hashText);
+			const auto size = qint64(data[u"size"_q].toDouble());
+			if (data[u"schema"_q].toInt() != 1 || hash.size() != 32 || hashText.size() != 64
+				|| size < 1024 || size > 512 * 1024 * 1024 || url.scheme() != u"https"_q
+				|| url.host() != u"github.com"_q || !url.userInfo().isEmpty()
+				|| !url.path().startsWith(u"/Qahnaarin7/TelegramR/releases/download/"_q) || !url.path().endsWith(u".exe"_q)) {
+				_status(u"Некоректні дані релізу. Оновлення відхилено."_q);
+				return;
+			}
+			if (data[u"versionCode"_q].toInt() <= ModVersionCode) {
+				_status(u"Встановлена актуальна версія TelegramR %1."_q.arg(ModVersion));
+				return;
+			}
+			_url = url;
+			_hash = hash;
+			_size = size;
+			_status(u"Доступна TelegramR %1. Натисни кнопку ще раз, щоб завантажити."_q.arg(data[u"version"_q].toString().left(24)));
+		});
+	}
+
+	void download() {
+		const auto directory = QStandardPaths::writableLocation(QStandardPaths::CacheLocation) + u"/TelegramR-updates"_q;
+		if (!QDir().mkpath(directory)) { _status(u"Не вдалося створити каталог оновлення."_q); return; }
+		const auto path = directory + u"/TelegramR-update-%1.exe"_q.arg(QString::fromLatin1(_hash.toHex()));
+		const auto file = std::make_shared<QSaveFile>(path);
+		if (!file->open(QIODevice::WriteOnly)) { _status(u"Не вдалося записати оновлення."_q); return; }
+		_busy = true;
+		const auto reply = get(_url);
+		const auto digest = std::make_shared<QCryptographicHash>(QCryptographicHash::Sha256);
+		const auto total = std::make_shared<qint64>(0);
+		const auto failed = std::make_shared<bool>(false);
+		QObject::connect(reply, &QNetworkReply::readyRead, this, [=] {
+			const auto bytes = reply->readAll();
+			*total += bytes.size();
+			if (*total > _size || file->write(bytes) != bytes.size()) {
+				*failed = true;
+				reply->abort();
+				return;
+			}
+			digest->addData(bytes);
+			_status(u"Завантаження: %1%"_q.arg((*total * 100) / _size));
+		});
+		QObject::connect(reply, &QNetworkReply::finished, this, [=] {
+			_busy = false;
+			reply->deleteLater();
+			if (*failed || reply->error() != QNetworkReply::NoError || *total != _size || digest->result() != _hash || !file->commit()) {
+				file->cancelWriting();
+				_status(u"Завантаження або перевірка SHA-256 не вдалися. Спробуй ще раз."_q);
+				return;
+			}
+			_ready = path;
+			_status(u"Файл перевірено. Натисни кнопку ще раз, щоб установити й перезапустити TelegramR."_q);
+		});
+	}
+
+	void launch(bool rollback) {
+		const auto app = QCoreApplication::applicationDirPath();
+		if (rollback && !QFileInfo::exists(app + u"/.telegramr-previous/TelegramR.exe"_q)) {
+			_status(u"Попередньої версії ще немає. Вона збережеться після першого оновлення."_q);
+			return;
+		}
+		const auto temporary = QStandardPaths::writableLocation(QStandardPaths::TempLocation)
+			+ u"/TelegramRUpdater-%1.exe"_q.arg(QCoreApplication::applicationPid());
+		QFile::remove(temporary);
+		if (!QFile::copy(app + u"/TelegramRUpdater.exe"_q, temporary)) {
+			_status(u"Помічник оновлення недоступний. Перевстанови TelegramR інсталятором."_q);
+			return;
+		}
+		const auto arguments = QStringList{ rollback ? u"--rollback"_q : u"--install"_q,
+			_ready, app, QString::number(QCoreApplication::applicationPid()), QString::fromLatin1(_hash.toHex()) };
+		if (!QProcess::startDetached(temporary, arguments, app)) {
+			_status(u"Не вдалося запустити помічник оновлення."_q);
+			return;
+		}
+		Core::Quit();
+	}
+
+	QNetworkAccessManager _network;
+	Fn<void(QString)> _status;
+	bool _busy = false;
+	QUrl _url;
+	QByteArray _hash;
+	qint64 _size = 0;
+	QString _ready;
+
+};
+
+}
