+QByteArray ModBackupPayload(not_null<Main::Session*> session) {
+	auto settings = QJsonObject();
+	for (const auto key : { Core::kModOffline, Core::kModUnread, Core::kModTyping, Core::kModDelay,
+		Core::kModDeleted, Core::kModEdited, Core::kModObserved, Core::kModSilent, Core::kModScheduledAlerts }) {
+		settings[QString::fromLatin1(key)] = qEnvironmentVariableIntValue(key) != 0;
+	}
+	auto rules = QJsonObject();
+	for (auto i = Core::ModChatRules().cbegin(); i != Core::ModChatRules().cend(); ++i) rules[i.key()] = i.value();
+	auto favorites = QJsonArray();
+	const auto &sets = session->data().stickers().sets();
+	const auto favorite = sets.find(Data::Stickers::FavedSetId);
+	if (favorite != sets.end()) {
+		for (const auto document : favorite->second->stickers) {
+			auto bytes = QByteArray();
+			auto stream = QDataStream(&bytes, QIODevice::WriteOnly);
+			stream.setVersion(QDataStream::Qt_5_1);
+			Serialize::Document::writeToStream(stream, document);
+			const auto &origin = document->sticker()->set;
+			favorites.append(QJsonObject{ { u"document"_q, QString::fromLatin1(bytes.toBase64()) },
+				{ u"set"_q, QString::number(origin.id) }, { u"hash"_q, QString::number(origin.accessHash) }, { u"short"_q, origin.shortName } });
+		}
+	}
+	return QJsonDocument(QJsonObject{ { u"version"_q, 1 }, { u"appVersion"_q, AppVersion },
+		{ u"settings"_q, settings }, { u"rules"_q, rules }, { u"favorites"_q, favorites } }).toJson(QJsonDocument::Compact);
+}
+
+bool ModRestoreBackup(not_null<Window::SessionController*> controller, const QByteArray &bytes) {
+	const auto document = QJsonDocument::fromJson(bytes);
+	if (!document.isObject()) return false;
+	const auto root = document.object();
+	if (root[u"version"_q].toInt() != 1 || !root[u"settings"_q].isObject()
+		|| !root[u"rules"_q].isObject() || !root[u"favorites"_q].isArray()
+		|| root[u"appVersion"_q].toInt() > AppVersion) return false;
+	const auto favoriteArray = root[u"favorites"_q].toArray();
+	if (favoriteArray.size() > 20000) return false;
+	auto favorites = std::vector<not_null<DocumentData*>>();
+	for (const auto &value : favoriteArray) {
+		const auto entry = value.toObject();
+		auto raw = QByteArray::fromBase64(entry[u"document"_q].toString().toLatin1());
+		if (raw.isEmpty() || raw.size() > 65536) return false;
+		auto stream = QDataStream(&raw, QIODevice::ReadOnly);
+		stream.setVersion(QDataStream::Qt_5_1);
+		const auto doc = Serialize::Document::readStickerFromStream(&controller->session(), root[u"appVersion"_q].toInt(), stream,
+			Serialize::Document::StickerSetInfo(entry[u"set"_q].toString().toULongLong(), entry[u"hash"_q].toString().toULongLong(), entry[u"short"_q].toString()));
+		if (!doc || !doc->sticker() || stream.status() != QDataStream::Ok || !stream.atEnd()) return false;
+		favorites.push_back(doc);
+	}
+	const auto settings = root[u"settings"_q].toObject();
+	for (const auto key : { Core::kModOffline, Core::kModUnread, Core::kModTyping, Core::kModDelay,
+		Core::kModDeleted, Core::kModEdited, Core::kModObserved, Core::kModSilent, Core::kModScheduledAlerts }) {
+		const auto value = settings[QString::fromLatin1(key)];
+		if (value.isBool()) Core::SetModOption(key, value.toBool());
+	}
+	for (const auto &key : Core::ModChatRules().keys()) {
+		QSettings config(cWorkingDir() + u"mod-settings.ini"_q, QSettings::IniFormat);
+		config.remove(key);
+	}
+	Core::ModChatRules().clear();
+	const auto rules = root[u"rules"_q].toObject();
+	for (auto i = rules.begin(); i != rules.end(); ++i) {
+		const auto parts = i.key().split('/');
+		if (parts.size() != 3 || parts[0] != u"Chats"_q || !parts[1].toULongLong()
+			|| (parts[2] != u"unread"_q && parts[2] != u"delay"_q && parts[2] != u"silent"_q)) continue;
+		Core::SetModChatRule(parts[2].toLatin1().constData(), parts[1].toULongLong(), i.value().toInt(-1));
+	}
+	for (auto i = favorites.rbegin(); i != favorites.rend(); ++i) controller->session().data().stickers().setFaved(controller->uiShow(), *i, true);
+	for (const auto account : Core::App().domain().orderedAccounts()) {
+		if (const auto session = account->maybeSession()) {
+			session->updates().updateOnline();
+			session->data().clearMessagePreviews(true);
+		}
+	}
+	return true;
+}
