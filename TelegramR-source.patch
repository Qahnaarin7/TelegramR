+TextWithEntities DisplayText(not_null<HistoryItem*> item, const TextWithEntities &text) {
+	const auto state = ModSessions.find(&item->history()->owner());
+	if (state == ModSessions.end()) return text;
+	auto id = item->fullId();
+	const auto preview = state->second.previews.find(id);
+	const auto deleted = preview != state->second.previews.end();
+	if (deleted) id = preview->second;
+	const auto i = state->second.messages.find(id);
+	if (i == state->second.messages.end()) return text;
+	const auto &record = i->second;
+	auto result = TextWithEntities();
+	if (deleted) {
+		const auto label = u"× Видалено\n"_q;
+		result.append(label);
+		result.entities.emplace_back(EntityType::Italic, 0, label.size());
+	}
+	if (qEnvironmentVariableIntValue("TDESKTOP_MOD_EDITED") && !record.revisions.empty()) {
+		const auto offset = result.text.size();
+		const auto label = u"↶ Редакції: %1%2\n"_q.arg(record.revisions.size()).arg(record.expanded ? u" ▴"_q : u" ▾"_q);
+		result.append(label);
+		result.entities.emplace_back(EntityType::CustomUrl, offset, label.size() - 1,
+			u"telegramr:revisions/%1/%2"_q.arg(id.peer.value).arg(id.msg.bare));
+		if (record.expanded) for (const auto &revision : record.revisions) {
+			const auto offset = result.text.size();
+			result.append(u"↶ Раніше\n"_q).append(revision.text).append(u"\n"_q);
+			result.entities.emplace_back(EntityType::Blockquote, offset, result.text.size() - offset);
+		}
+	}
+	result.append(text);
+	std::stable_sort(result.entities.begin(), result.entities.end(), [](const auto &a, const auto &b) {
+		return a.offset() < b.offset() || (a.offset() == b.offset() && a.length() > b.length());
+	});
+	return result;
+}
