+						const auto updater = new Core::ModUpdater(update, [=](QString text) { status->setText(std::move(text)); });
+						Settings::AddButtonWithIcon(update->verticalLayout(), rpl::single(u"Перевірити / продовжити"_q), st::settingsButton,
