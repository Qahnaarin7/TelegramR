+void ModBackupBox(not_null<Ui::GenericBox*> box, not_null<Window::SessionController*> controller, bool restore) {
+	box->setTitle(rpl::single(restore ? u"Імпорт резервної копії"_q : u"Експорт резервної копії"_q));
+	box->setWidth(460);
+	box->addRow(object_ptr<Ui::FlatLabel>(box,
+		u"Налаштування TelegramR і список улюблених наліпок. Сеанси входу, листування й архів не копіюються. Пароль — щонайменше 12 символів."_q, st::settingsExperimentalAbout));
+	const auto passwordWrap = box->addRow(object_ptr<Ui::RpWidget>(box));
+	const auto password = Ui::CreateChild<Ui::PasswordInput>(passwordWrap, st::defaultInputField, rpl::single(u"Пароль резервної копії"_q));
+	password->heightValue() | rpl::on_next([=](int height) {
+		passwordWrap->resize(passwordWrap->width(), height);
+	}, password->lifetime());
+	passwordWrap->widthValue() | rpl::on_next([=](int width) {
+		password->resize(width, password->height());
+	}, password->lifetime());
+	const auto status = box->addRow(object_ptr<Ui::FlatLabel>(box, QString(), st::settingsExperimentalAbout));
+	box->addButton(rpl::single(restore ? u"Відкрити"_q : u"Зберегти"_q), [=] {
+		if (password->getLastText().size() < 12) {
+			status->setText(u"Потрібно щонайменше 12 символів."_q);
+			return;
+		}
+		const auto secret = password->getLastText().toUtf8().toStdString();
+		const auto weak = base::make_weak(box.get());
+		if (!restore) {
+			const auto raw = ModBackupPayload(&controller->session());
+			const auto encrypted = Core::ModCrypto::Transform(Core::ModCrypto::Bytes(raw.begin(), raw.end()), secret, true);
+			if (!encrypted) { status->setText(u"Не вдалося зашифрувати копію (ліміт 16 МБ)."_q); return; }
+			const auto bytes = QByteArray(reinterpret_cast<const char*>(encrypted->data()), encrypted->size());
+			FileDialog::GetWritePath(Core::App().getFileDialogParent(), u"Резервна копія TelegramR"_q, u"TelegramR (*.trbackup)"_q, u"TelegramR.trbackup"_q,
+				[=](QString path) {
+					if (!weak || path.isEmpty()) return;
+					auto file = QSaveFile(path);
+					if (!file.open(QIODevice::WriteOnly) || file.write(bytes) != bytes.size() || !file.commit()) {
+						status->setText(u"Не вдалося записати файл."_q); return;
+					}
+					password->setText(QString());
+					status->setText(u"Зашифровану копію збережено."_q);
+				});
+		} else {
+			FileDialog::GetOpenPath(Core::App().getFileDialogParent(), u"Резервна копія TelegramR"_q, u"TelegramR (*.trbackup)"_q,
+				[=](FileDialog::OpenResult result) {
+					if (!weak || result.paths.isEmpty()) return;
+					auto file = QFile(result.paths.front());
+					if (!file.open(QIODevice::ReadOnly) || file.size() > Core::ModCrypto::MaxSize + 52) {
+						status->setText(u"Файл недоступний або завеликий."_q); return;
+					}
+					const auto bytes = file.readAll();
+					const auto decoded = Core::ModCrypto::Transform(Core::ModCrypto::Bytes(bytes.begin(), bytes.end()), secret, false);
+					if (!decoded || !ModRestoreBackup(controller, QByteArray(reinterpret_cast<const char*>(decoded->data()), decoded->size()))) {
+						status->setText(u"Неправильний пароль або пошкоджена/несумісна копія."_q); return;
+					}
+					password->setText(QString());
+					status->setText(u"Налаштування й наліпки імпортовано. Повторно відкрий «Додатково»."_q);
+				});
+		}
+	});
+	box->addButton(tr::lng_close(), [=] { box->closeBox(); });
+}
