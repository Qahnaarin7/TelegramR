+namespace {
+
+struct ModRevision {
+	TextWithEntities text;
+};
+
+struct ModMessageRecord {
+	FullMsgId id;
+	FullMsgId preview;
+	PeerId from;
+	FullReplyTo reply;
+	TimeId date = 0;
+	bool outgoing = false;
+	bool deleted = false;
+	bool expanded = false;
+	QString chatName;
+	TimeId saved = 0;
+	TextWithEntities text;
+	std::vector<ModRevision> revisions;
+};
+
+struct ModSessionState {
+	bool loaded = false;
+	bool savePending = false;
+	bool writePending = false;
+	int saveGeneration = 0;
+	bool loadFailed = false;
+	std::set<PeerId> restored;
+	std::map<FullMsgId, ModMessageRecord> messages;
+	std::map<FullMsgId, FullMsgId> previews;
+	std::deque<FullMsgId> order;
+	std::map<PeerId, TimeId> activity;
+};
+
+std::map<Session*, ModSessionState> ModSessions;
+
+
+QJsonObject ModTextJson(const TextWithEntities &text) {
+	auto entities = QJsonArray();
+	for (const auto &entity : text.entities) {
+		entities.append(QJsonArray{ int(entity.type()), entity.offset(), entity.length(), entity.data() });
+	}
+	return { { u"text"_q, text.text }, { u"entities"_q, entities } };
+}
+
+TextWithEntities ModTextFromJson(const QJsonObject &data) {
+	auto result = TextWithEntities{ data[u"text"_q].toString().left(65536) };
+	for (const auto &value : data[u"entities"_q].toArray()) {
+		const auto fields = value.toArray();
+		if (fields.size() != 4) continue;
+		const auto type = fields[0].toInt(-1);
+		if (type <= 0 || type > int(EntityType::FormattedDate)) continue;
+		const auto entity = EntityInText(EntityType(type), fields[1].toInt(), fields[2].toInt(), fields[3].toString());
+		if (entity.validForText(result.text.size())) result.entities.push_back(entity);
+	}
+	return result;
+}
+
+int ModRetentionDays() {
+	const QSettings settings(cWorkingDir() + u"mod-settings.ini"_q, QSettings::IniFormat);
+	return std::clamp(settings.value(u"archiveRetentionDays"_q, 30).toInt(), 1, 365);
+}
+
+ModSessionState &ModState(not_null<Session*> owner) {
+	auto &state = ModSessions[owner.get()];
+	if (state.loaded) return state;
+	state.loaded = true;
+	const auto encoded = owner->session().local().readPref<QString>("telegramr.archive.v1", QString());
+	if (encoded.isEmpty()) return state;
+	const auto packed = QByteArray::fromBase64(encoded.toLatin1());
+	if (packed.size() < 4 || packed.size() > 16 * 1024 * 1024) {
+		state.loadFailed = true;
+		return state;
+	}
+	const auto declared = (quint32(uchar(packed[0])) << 24)
+		| (quint32(uchar(packed[1])) << 16) | (quint32(uchar(packed[2])) << 8) | quint32(uchar(packed[3]));
+	if (declared > 32 * 1024 * 1024) {
+		state.loadFailed = true;
+		return state;
+	}
+	const auto document = QJsonDocument::fromJson(qUncompress(packed));
+	if (!document.isObject() || document.object()[u"version"_q].toInt() != 1) {
+		state.loadFailed = true;
+		return state;
+	}
+	const auto cutoff = base::unixtime::now() - ModRetentionDays() * 86400;
+	const auto messages = document.object()[u"messages"_q].toArray();
+	for (const auto &value : messages) {
+		if (state.messages.size() >= 2000) break;
+		const auto data = value.toObject();
+		auto record = ModMessageRecord();
+		record.id = { PeerId(data[u"peer"_q].toString().toULongLong()), MsgId(data[u"id"_q].toString().toLongLong()) };
+		record.from = PeerId(data[u"from"_q].toString().toULongLong());
+		record.date = data[u"date"_q].toInt();
+		record.saved = data[u"saved"_q].toInt();
+		if (!record.id || !record.from || record.date <= 0 || record.saved < cutoff) continue;
+		record.reply.messageId = { PeerId(data[u"replyPeer"_q].toString().toULongLong()), MsgId(data[u"replyId"_q].toString().toLongLong()) };
+		record.reply.topicRootId = MsgId(data[u"topic"_q].toString().toLongLong());
+		record.reply.monoforumPeerId = PeerId(data[u"mono"_q].toString().toULongLong());
+		record.outgoing = data[u"out"_q].toBool();
+		record.deleted = data[u"deleted"_q].toBool();
+		record.chatName = data[u"chat"_q].toString();
+		record.text = ModTextFromJson(data[u"text"_q].toObject());
+		for (const auto &revision : data[u"revisions"_q].toArray()) {
+			if (record.revisions.size() == 8) break;
+			record.revisions.push_back({ ModTextFromJson(revision.toObject()) });
+		}
+		if (state.messages.emplace(record.id, record).second) state.order.push_back(record.id);
+	}
+	return state;
+}
+
+void ModSave(not_null<Session*> owner, bool immediate = false) {
+	auto &state = ModState(owner);
+	state.savePending = false;
+	if (state.loadFailed) return;
+	auto messages = QJsonArray();
+	const auto cutoff = base::unixtime::now() - ModRetentionDays() * 86400;
+	for (const auto &[id, record] : state.messages) {
+		if (record.saved < cutoff) continue;
+		auto revisions = QJsonArray();
+		for (const auto &revision : record.revisions) revisions.append(ModTextJson(revision.text));
+		messages.append(QJsonObject{
+			{ u"peer"_q, QString::number(id.peer.value) }, { u"id"_q, QString::number(id.msg.bare) },
+			{ u"from"_q, QString::number(record.from.value) }, { u"date"_q, record.date }, { u"saved"_q, record.saved },
+			{ u"replyPeer"_q, QString::number(record.reply.messageId.peer.value) }, { u"replyId"_q, QString::number(record.reply.messageId.msg.bare) },
+			{ u"topic"_q, QString::number(record.reply.topicRootId.bare) }, { u"mono"_q, QString::number(record.reply.monoforumPeerId.value) },
+			{ u"out"_q, record.outgoing }, { u"deleted"_q, record.deleted }, { u"chat"_q, record.chatName },
+			{ u"text"_q, ModTextJson(record.text) }, { u"revisions"_q, revisions }
+		});
+	}
+	const auto document = QJsonDocument(QJsonObject{ { u"version"_q, 1 }, { u"messages"_q, messages } });
+	const auto generation = ++state.saveGeneration;
+	const auto encode = [=] {
+		const auto bytes = document.toJson(QJsonDocument::Compact);
+		return bytes.size() > 32 * 1024 * 1024 ? QString() : QString::fromLatin1(qCompress(bytes, 1).toBase64());
+	};
+	if (immediate) {
+		const auto encoded = encode();
+		if (!encoded.isEmpty()) owner->session().local().writePref<QString>("telegramr.archive.v1", encoded);
+		state.writePending = false;
+	} else {
+		state.writePending = true;
+		const auto weak = base::make_weak(&owner->session());
+		crl::async([=] {
+			const auto encoded = encode();
+			crl::on_main([=] {
+				if (!weak) return;
+				const auto i = ModSessions.find(&weak->data());
+				if (i == ModSessions.end() || i->second.saveGeneration != generation) return;
+				i->second.writePending = false;
+				if (!encoded.isEmpty()) weak->local().writePref<QString>("telegramr.archive.v1", encoded);
+			});
+		});
+	}
+}
+
+void ModSaveLater(not_null<Session*> owner) {
+	auto &state = ModState(owner);
+	if (state.savePending) return;
+	state.savePending = true;
+	base::call_delayed(1500, &owner->session(), [=] { ModSave(owner); });
+}
+
+void ModRemovePreview(not_null<Session*> owner, ModMessageRecord &record) {
+	if (!record.preview) return;
+	auto &state = ModSessions[owner.get()];
+	state.previews.erase(record.preview);
+	if (const auto item = owner->message(record.preview)) {
+		item->destroy();
+	}
+	record.preview = {};
+}
+
+ModMessageRecord &ModRemember(not_null<Session*> owner, not_null<HistoryItem*> item) {
+	auto &state = ModState(owner);
+	const auto id = item->fullId();
+	const auto [i, inserted] = state.messages.try_emplace(id);
+	if (inserted) {
+		state.order.push_back(id);
+		while (state.order.size() > 2000) {
+			const auto oldest = state.order.front();
+			state.order.pop_front();
+			const auto old = state.messages.find(oldest);
+			if (old != state.messages.end()) {
+				ModRemovePreview(owner, old->second);
+				state.messages.erase(old);
+				if (const auto original = owner->message(oldest)) {
+					owner->requestItemTextRefresh(original);
+				}
+			}
+		}
+	}
+	auto &record = i->second;
+	record.id = id;
+	record.from = item->from()->id;
+	record.reply = item->replyTo();
+	record.reply.topicRootId = item->replyToTop() ? item->replyToTop() : item->topicRootId();
+	if (const auto root = item->replyToTop(); root && !record.reply.messageId) {
+		record.reply.messageId = { item->history()->peer->id, root };
+	}
+	record.date = item->date();
+	record.saved = base::unixtime::now();
+	record.chatName = item->history()->peer->name();
+	record.outgoing = item->out();
+	record.text = item->originalText();
+	return record;
+}
+
+void ModCreatePreview(not_null<Session*> owner, ModMessageRecord &record) {
+	if (record.preview || !record.deleted
+		|| !qEnvironmentVariableIntValue("TDESKTOP_MOD_DELETED")) {
+		return;
+	}
+	const auto history = owner->historyLoaded(record.id.peer);
+	if (!history) return;
+	const auto ghost = history->addNewLocalMessage(
+		HistoryItemCommonFields{
+			.id = owner->nextLocalMessageId(),
+			.flags = MessageFlag::Local | MessageFlag::HistoryEntry
+				| MessageFlag::HasFromId | MessageFlag::NoForwards
+				| MessageFlag::Silent
+				| ((record.reply.messageId || record.reply.topicRootId
+					|| record.reply.monoforumPeerId)
+					? MessageFlag::HasReplyInfo : MessageFlag())
+				| (record.outgoing ? MessageFlag::Outgoing : MessageFlag()),
+			.from = record.from,
+			.replyTo = record.reply,
+			.date = record.date,
+		}, record.text, MTP_messageMediaEmpty());
+	record.preview = ghost->fullId();
+	ModSessions[owner.get()].previews.emplace(record.preview, record.id);
+	owner->requestItemTextRefresh(ghost);
+}
+
+void RememberMessageVersion(
+		not_null<Session*> owner,
+		std::vector<std::pair<FullMsgId, bool>> &,
+		not_null<HistoryItem*> item,
+		bool edited) {
+	if (!qEnvironmentVariableIntValue(edited ? "TDESKTOP_MOD_EDITED" : "TDESKTOP_MOD_DELETED")
+		|| !item->isRegular() || item->isService() || item->isEphemeral()
+		|| item->ttlDestroyAt() || (item->media() && item->media()->ttlSeconds())
+		|| item->originalText().empty()) {
+		return;
+	}
+	auto &record = ModRemember(owner, item);
+	if (edited) {
+		if (record.revisions.empty() || record.revisions.back().text.text != record.text.text) {
+			if (record.revisions.size() == 8) record.revisions.erase(record.revisions.begin());
+			record.revisions.push_back({ record.text });
+		}
+	} else {
+		record.deleted = true;
+		ModCreatePreview(owner, record);
+	}
+	ModSaveLater(owner);
+}
+
+void ModRecordActivity(not_null<Session*> owner, not_null<HistoryItem*> item, TimeId date) {
+	if (!qEnvironmentVariableIntValue("TDESKTOP_MOD_OBSERVED") || !item->isRegular()
+		|| item->out() || item->isService()) return;
+	const auto user = item->from()->asUser();
+	const auto now = base::unixtime::now();
+	if (!user || user->isBot() || user->isServiceUser() || user->isSelf() || date > now + 30 || date < now - 300) return;
+	auto &activity = ModSessions[owner.get()].activity;
+	auto &last = activity[user->id];
+	if (date <= last) return;
+	last = date;
+	if (activity.size() > 1000) {
+		const auto oldest = std::min_element(activity.begin(), activity.end(), [](const auto &a, const auto &b) {
+			return a.second < b.second;
+		});
+		activity.erase(oldest);
+	}
+	owner->session().changes().peerUpdated(user, PeerUpdate::Flag::OnlineStatus);
+}
+
