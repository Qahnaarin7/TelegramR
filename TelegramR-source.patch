diff --git a/Telegram/SourceFiles/core/mod_crypto.h b/Telegram/SourceFiles/core/mod_crypto.h
new file mode 100644
index 0000000..cb14808
--- /dev/null
+++ b/Telegram/SourceFiles/core/mod_crypto.h
@@ -0,0 +1,81 @@
+#pragma once
+
+#include <openssl/evp.h>
+#include <openssl/rand.h>
+#include <openssl/crypto.h>
+#include <algorithm>
+#include <array>
+#include <memory>
+#include <optional>
+#include <string>
+#include <vector>
+
+namespace Core::ModCrypto {
+
+using Bytes = std::vector<unsigned char>;
+inline constexpr auto MaxSize = 16 * 1024 * 1024;
+inline constexpr auto HeaderSize = 36;
+inline constexpr auto TagSize = 16;
+inline constexpr auto Magic = std::array<unsigned char, 8>{ 'R', 'B', 'A', 'C', 'K', 'U', 'P', '1' };
+
+
+inline bool VerifyRelease(const Bytes &payload, const Bytes &signature, const Bytes &publicKey) {
+	if (payload.empty() || payload.size() > 65536 || signature.size() != 64 || publicKey.size() != 32) return false;
+	const auto key = std::unique_ptr<EVP_PKEY, decltype(&EVP_PKEY_free)>(
+		EVP_PKEY_new_raw_public_key(EVP_PKEY_ED25519, nullptr, publicKey.data(), publicKey.size()), EVP_PKEY_free);
+	const auto context = std::unique_ptr<EVP_MD_CTX, decltype(&EVP_MD_CTX_free)>(EVP_MD_CTX_new(), EVP_MD_CTX_free);
+	return key && context && EVP_DigestVerifyInit(context.get(), nullptr, nullptr, nullptr, key.get()) == 1
+		&& EVP_DigestVerify(context.get(), signature.data(), signature.size(), payload.data(), payload.size()) == 1;
+}
+
+inline std::optional<Bytes> Transform(
+		const Bytes &input,
+		const std::string &password,
+		bool encrypt) {
+	if (password.size() < 12 || password.size() > 1024 || input.size() > MaxSize + (encrypt ? 0 : HeaderSize + TagSize)
+		|| (!encrypt && (input.size() < HeaderSize + TagSize
+			|| !std::equal(Magic.begin(), Magic.end(), input.begin())))) {
+		return std::nullopt;
+	}
+	auto output = Bytes(encrypt ? HeaderSize + input.size() + TagSize : input.size() - HeaderSize - TagSize + 16);
+	auto header = std::array<unsigned char, HeaderSize>();
+	if (encrypt) {
+		std::copy(Magic.begin(), Magic.end(), header.begin());
+		if (RAND_bytes(header.data() + 8, HeaderSize - 8) != 1) return std::nullopt;
+	} else {
+		std::copy_n(input.begin(), HeaderSize, header.begin());
+	}
+	auto key = std::array<unsigned char, 32>();
+	if (PKCS5_PBKDF2_HMAC(password.data(), int(password.size()), header.data() + 8,
+		16, 300000, EVP_sha256(), int(key.size()), key.data()) != 1) return std::nullopt;
+	auto context = std::unique_ptr<EVP_CIPHER_CTX, decltype(&EVP_CIPHER_CTX_free)>(EVP_CIPHER_CTX_new(), EVP_CIPHER_CTX_free);
+	if (!context) {
+		OPENSSL_cleanse(key.data(), key.size());
+		return std::nullopt;
+	}
+	const auto init = EVP_CipherInit_ex(context.get(), EVP_aes_256_gcm(), nullptr, key.data(), header.data() + 24, encrypt ? 1 : 0);
+	OPENSSL_cleanse(key.data(), key.size());
+	if (init != 1) return std::nullopt;
+	auto count = 0;
+	if (EVP_CipherUpdate(context.get(), nullptr, &count, header.data(), HeaderSize) != 1) return std::nullopt;
+	const auto source = input.data() + (encrypt ? 0 : HeaderSize);
+	const auto length = int(encrypt ? input.size() : input.size() - HeaderSize - TagSize);
+	auto target = output.data() + (encrypt ? HeaderSize : 0);
+	if (EVP_CipherUpdate(context.get(), target, &count, source, length) != 1) return std::nullopt;
+	const auto produced = count;
+	if (!encrypt && EVP_CIPHER_CTX_ctrl(context.get(), EVP_CTRL_GCM_SET_TAG, TagSize,
+		const_cast<unsigned char*>(input.data() + input.size() - TagSize)) != 1) return std::nullopt;
+	if (EVP_CipherFinal_ex(context.get(), target + produced, &count) != 1) {
+		OPENSSL_cleanse(output.data(), output.size());
+		return std::nullopt;
+	}
+	if (encrypt) {
+		std::copy(header.begin(), header.end(), output.begin());
+		if (EVP_CIPHER_CTX_ctrl(context.get(), EVP_CTRL_GCM_GET_TAG, TagSize,
+			output.data() + output.size() - TagSize) != 1) return std::nullopt;
+	}
+	if (!encrypt) output.resize(length);
+	return output;
+}
+
+}
diff --git a/Telegram/SourceFiles/core/mod_settings.h b/Telegram/SourceFiles/core/mod_settings.h
new file mode 100644
index 0000000..e50471f
--- /dev/null
+++ b/Telegram/SourceFiles/core/mod_settings.h
@@ -0,0 +1,81 @@
+#pragma once
+
+#include <QtCore/QSettings>
+#include <QtCore/QMap>
+
+namespace Core {
+
+inline constexpr auto kModOffline = "TDESKTOP_MOD_OFFLINE";
+inline constexpr auto kModUnread = "TDESKTOP_MOD_UNREAD";
+inline constexpr auto kModDeleted = "TDESKTOP_MOD_DELETED";
+inline constexpr auto kModEdited = "TDESKTOP_MOD_EDITED";
+inline constexpr auto kModDelay = "TDESKTOP_MOD_DELAY";
+inline constexpr auto kModTyping = "TDESKTOP_MOD_TYPING";
+inline constexpr auto kModObserved = "TDESKTOP_MOD_OBSERVED";
+
+inline constexpr auto kModScheduledAlerts = "TDESKTOP_MOD_SCHEDULED_ALERTS";
+inline constexpr auto kModSilent = "TDESKTOP_MOD_SILENT";
+
+
+inline QMap<QString, int> &ModChatRules() {
+	static auto rules = [] {
+		auto result = QMap<QString, int>();
+		const QSettings settings(cWorkingDir() + u"mod-settings.ini"_q, QSettings::IniFormat);
+		for (const auto &key : settings.allKeys()) {
+			if (key.startsWith(u"Chats/"_q)) result.insert(key, settings.value(key).toInt());
+		}
+		return result;
+	}();
+	return rules;
+}
+
+inline QString ModChatRuleKey(const char *name, quint64 peer) {
+	return u"Chats/%1/%2"_q.arg(peer).arg(QString::fromLatin1(name));
+}
+
+inline int ModChatRule(const char *name, quint64 peer) {
+	return ModChatRules().value(ModChatRuleKey(name, peer), -1);
+}
+
+inline void SetModChatRule(const char *name, quint64 peer, int value) {
+	const auto key = ModChatRuleKey(name, peer);
+	QSettings settings(cWorkingDir() + u"mod-settings.ini"_q, QSettings::IniFormat);
+	if (value < 0) {
+		settings.remove(key);
+		ModChatRules().remove(key);
+	} else {
+		settings.setValue(key, value != 0 ? 1 : 0);
+		ModChatRules().insert(key, value != 0 ? 1 : 0);
+	}
+}
+
+inline bool ModChatOption(const char *name, quint64 peer, const char *global) {
+	const auto rule = ModChatRule(name, peer);
+	return qEnvironmentVariableIntValue("TDESKTOP_MOD_ISOLATED")
+		&& (rule < 0 ? qEnvironmentVariableIntValue(global) != 0 : rule != 0);
+}
+
+inline bool ModUnreadBlocked(quint64 peer) {
+	return ModChatOption("unread", peer, kModUnread);
+}
+
+inline void RestoreModOptions() {
+	if (!qEnvironmentVariableIntValue("TDESKTOP_MOD_ISOLATED")) {
+		return;
+	}
+	const QSettings settings(cWorkingDir() + u"mod-settings.ini"_q, QSettings::IniFormat);
+	for (const auto key : { kModOffline, kModUnread, kModTyping, kModDeleted, kModEdited, kModDelay, kModObserved, kModSilent, kModScheduledAlerts }) {
+		const auto name = QString::fromLatin1(key);
+		if (settings.contains(name)) {
+			qputenv(key, settings.value(name).toBool() ? "1" : "0");
+		}
+	}
+}
+
+inline void SetModOption(const char *key, bool enabled) {
+	QSettings settings(cWorkingDir() + u"mod-settings.ini"_q, QSettings::IniFormat);
+	settings.setValue(QString::fromLatin1(key), enabled);
+	qputenv(key, enabled ? "1" : "0");
+}
+
+} // namespace Core
