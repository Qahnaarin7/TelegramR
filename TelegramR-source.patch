+void ModQueueBox(not_null<Ui::GenericBox*> box, not_null<Window::SessionController*> controller, not_null<PeerData*> peer) {
+	box->setTitle(rpl::single(u"Відкладені · %1"_q.arg(peer->name())));
+	box->setWidth(460);
+	box->setMaxHeight(600);
+	box->addRow(object_ptr<Ui::FlatLabel>(box,
+		u"Текст і медіа з поточного чату, включно з ручним плануванням. Відлік починається після завантаження. Скасування діє, доки сервер ще не надіслав повідомлення."_q, st::settingsExperimentalAbout));
+	const auto summary = box->addRow(object_ptr<Ui::FlatLabel>(box, QString(), st::settingsExperimentalAbout));
+	struct Row {
+		Ui::FlatLabel *label = nullptr;
+		Settings::Button *cancel = nullptr;
+	};
+	const auto rows = std::make_shared<std::map<FullMsgId, Row>>();
+	const auto session = &controller->session();
+	const auto history = session->data().history(peer);
+	const auto tick = [=] {
+		const auto ids = session->scheduledMessages().list(history).ids;
+		summary->setText(ids.empty() ? u"Черга порожня."_q : u"У черзі: %1"_q.arg(ids.size()));
+		for (const auto id : ids) {
+			if (rows->size() >= 100 && !rows->contains(id)) continue;
+			const auto item = session->scheduledMessages().lookupItem(id);
+			if (!item) continue;
+			auto &row = (*rows)[id];
+			if (!row.label) {
+				row.label = box->addRow(object_ptr<Ui::FlatLabel>(box, QString(), st::settingsExperimentalAbout));
+				row.cancel = Settings::AddButtonWithIcon(box->verticalLayout(), rpl::single(u"Скасувати надсилання"_q), st::settingsButton).get();
+				const auto weak = base::make_weak(box.get());
+				row.cancel->setClickedCallback([=] {
+					const auto item = session->scheduledMessages().lookupItem(id);
+					if (!item || item->isSending()) return;
+					const auto serverId = session->scheduledMessages().lookupId(item);
+					session->api().request(MTPmessages_DeleteScheduledMessages(peer->input(), MTP_vector<MTPint>(1, MTP_int(serverId)))
+					).done([=](const MTPUpdates &updates) {
+						session->api().applyUpdates(updates);
+					}).fail([=] {
+						if (weak) (*rows)[id].label->setText(u"Не вдалося скасувати. Перевір підключення."_q);
+					}).send();
+				});
+			}
+			const auto seconds = std::max(TimeId(0), item->date() - base::unixtime::now());
+			const auto when = seconds <= 120 ? u"%1 с"_q.arg(seconds)
+				: QDateTime::fromSecsSinceEpoch(item->date()).toLocalTime().toString(u"dd.MM HH:mm:ss"_q);
+			row.label->setText((item->isSending() ? u"Завантаження…"_q : u"Через %1"_q.arg(when))
+				+ u"\n"_q + (item->originalText().empty() ? u"Медіа"_q : item->originalText().text.left(100)));
+			row.cancel->setDisabled(item->isSending());
+		}
+		for (auto &[id, row] : *rows) {
+			if (std::find(ids.begin(), ids.end(), id) == ids.end()) {
+				row.label->setText(u"Відправлено або скасовано."_q);
+				row.cancel->setDisabled(true);
+			}
+		}
+	};
+	session->scheduledMessages().updates(history) | rpl::on_next(tick, box->lifetime());
+	const auto timer = new QTimer(box);
+	QObject::connect(timer, &QTimer::timeout, box, tick);
+	timer->start(1000);
+	tick();
+	box->addButton(tr::lng_close(), [=] { box->closeBox(); });
+}
