+bool IsDeleted(not_null<const HistoryItem*> item) {
+	const auto state = ModSessions.find(&item->history()->owner());
+	return state != ModSessions.end() && state->second.previews.contains(item->fullId());
+}
+
+QString ObservedActivity(not_null<UserData*> user, TimeId now) {
+	if (!qEnvironmentVariableIntValue("TDESKTOP_MOD_OBSERVED") || !user->lastseen().isHidden()) return {};
+	const auto state = ModSessions.find(&user->owner());
+	if (state == ModSessions.end()) return {};
+	const auto i = state->second.activity.find(user->id);
+	if (i == state->second.activity.end()) return {};
+	return (now - i->second < 60)
+		? u"Щойно активний (за зафіксованою активністю)"_q
+		: u"Активність %1 (за зафіксованою активністю)"_q.arg(
+			QDateTime::fromSecsSinceEpoch(i->second).toLocalTime().toString(u"dd.MM HH:mm"_q));
+}
+
+void RefreshOptions(not_null<Session*> owner) {
+	const auto state = ModSessions.find(owner.get());
+	if (state == ModSessions.end()) return;
+	for (auto &[id, record] : state->second.messages) {
+		if (record.deleted) {
+			if (qEnvironmentVariableIntValue("TDESKTOP_MOD_DELETED")) ModCreatePreview(owner, record);
+			else ModRemovePreview(owner, record);
+		}
+		if (const auto original = owner->message(id)) owner->requestItemTextRefresh(original);
+		if (const auto preview = owner->message(record.preview)) owner->requestItemTextRefresh(preview);
+	}
+	for (const auto &[peer, when] : state->second.activity) {
+		owner->session().changes().peerUpdated(owner->peer(peer), PeerUpdate::Flag::OnlineStatus);
+	}
+}
+
+
+void ToggleRevisions(not_null<Session*> owner, FullMsgId id) {
+	auto &state = ModState(owner);
+	const auto i = state.messages.find(id);
+	if (i == state.messages.end()) return;
+	i->second.expanded = !i->second.expanded;
+	if (const auto item = owner->message(id)) owner->requestItemTextRefresh(item);
+	if (const auto ghost = owner->message(i->second.preview)) owner->requestItemTextRefresh(ghost);
+}
+
+QString SearchArchive(not_null<Session*> owner, const QString &query) {
+	auto &state = ModState(owner);
+	if (state.loadFailed) return u"Архів не вдалося прочитати. Попередні дані залишено без змін."_q;
+	auto result = QString();
+	auto count = 0;
+	for (const auto &[id, record] : state.messages) {
+		if (record.saved < base::unixtime::now() - ModRetentionDays() * 86400) continue;
+		if ((record.deleted && !qEnvironmentVariableIntValue("TDESKTOP_MOD_DELETED"))
+			|| (!record.deleted && !qEnvironmentVariableIntValue("TDESKTOP_MOD_EDITED"))) continue;
+		auto text = record.text.text;
+		if (qEnvironmentVariableIntValue("TDESKTOP_MOD_EDITED")) {
+			for (const auto &revision : record.revisions) text += u"\n↶ "_q + revision.text.text;
+		}
+		if (!query.isEmpty() && !text.contains(query, Qt::CaseInsensitive) && !record.chatName.contains(query, Qt::CaseInsensitive)) continue;
+		result += u"%1 · %2%3\n%4\n\n"_q.arg(record.chatName,
+			QDateTime::fromSecsSinceEpoch(record.date).toLocalTime().toString(u"dd.MM.yyyy HH:mm"_q),
+			record.deleted ? u" · видалено"_q : QString(), text.left(3000));
+		if (++count >= 40) break;
+	}
+	return result.isEmpty() ? u"Збережених збігів немає."_q : result;
+}
+
+void ClearArchive(not_null<Session*> owner) {
+	auto &state = ModState(owner);
+	auto ids = std::vector<FullMsgId>();
+	for (auto &[id, record] : state.messages) {
+		ModRemovePreview(owner, record);
+		ids.push_back(id);
+	}
+	state.messages.clear();
+	for (const auto id : ids) {
+		if (const auto item = owner->message(id)) owner->requestItemTextRefresh(item);
+	}
+	state.order.clear();
+	state.loadFailed = false;
+	ModSave(owner);
+}
+
+void RestoreArchive(not_null<Session*> owner, PeerId peer) {
+	if (!qEnvironmentVariableIntValue("TDESKTOP_MOD_ISOLATED")) return;
+	auto &state = ModState(owner);
+	if (!state.restored.emplace(peer).second) return;
+	base::call_delayed(0, &owner->session(), [=] {
+		const auto i = ModSessions.find(owner.get());
+		if (i == ModSessions.end()) return;
+		for (auto &[id, record] : i->second.messages) {
+			if (id.peer == peer) ModCreatePreview(owner, record);
+		}
+	});
+}
+
+void ForgetSession(Session *owner) {
+	if (const auto i = ModSessions.find(owner); i != ModSessions.end() && (i->second.savePending || i->second.writePending)) ModSave(owner, true);
+	ModSessions.erase(owner);
+}
